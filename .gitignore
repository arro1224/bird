# ============================================================
# Operating systems and temporary files
# ============================================================
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ============================================================
# IDEs and editors
# ============================================================
.idea/
*.iml
*.ipr
*.iws
.atom/
.history/

# VS Code launch/tasks/settings are often useful to the whole team, so the
# directory remains trackable. Uncomment this rule if all settings are local.
# .vscode/

# ============================================================
# Dart, Flutter and Pub generated files
# ============================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# Generated test failure images (golden test diagnostics)
test/**/failures/

# Flutter symbolication and obfuscation outputs
app.*.symbols
app.*.map.json

# ============================================================
# Android and Gradle generated/local files
# ============================================================
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
local.properties
GeneratedPluginRegistrant.java

# APK/AAB output directories created by Android Studio
android/app/debug/
android/app/profile/
android/app/release/

# Local signing configuration and private keys
key.properties
*.jks
*.keystore

# ============================================================
# Other generated tool files
# ============================================================
*.class
*.pyc
__pycache__/
.build/
.buildlog/
.svn/
.swiftpm/
migrate_working_dir/

