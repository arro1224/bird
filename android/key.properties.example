# Copy this file to android/key.properties and replace every placeholder.
# android/key.properties and *.jks/*.keystore are ignored by Git.
#
# storeFile is resolved relative to the android directory.
storeFile=../secrets/aves-release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=aves-release
keyPassword=REPLACE_WITH_KEY_PASSWORD

# CI may omit key.properties and provide these environment variables instead:
# AVES_RELEASE_STORE_FILE
# AVES_RELEASE_STORE_PASSWORD
# AVES_RELEASE_KEY_ALIAS
# AVES_RELEASE_KEY_PASSWORD
