{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bird Box job event v1",
  "type": "object",
  "required": ["event_type", "payload"],
  "properties": {
    "event_type": {"enum": ["job_updated", "job_progress", "job_state_changed"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "required": ["job_id", "job_state"],
      "properties": {
        "job_id": {"type": "string"},
        "job_state": {"enum": ["idle", "running", "paused", "completed", "failed", "cancelled"]},
        "job_type": {"enum": ["import", "analysis", "copy", "sync"]},
        "progress": {"type": "number", "minimum": 0, "maximum": 1},
        "total_count": {"type": "integer", "minimum": 0},
        "finished_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "current_file": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
