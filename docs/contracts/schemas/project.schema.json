{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birdbox.local/contracts/v1/schemas/project.schema.json",
  "title": "Project",
  "type": "object",
  "required": [
    "project_id",
    "name",
    "created_at",
    "total_files",
    "analyzed_count",
    "pending_review_count",
    "keep_count",
    "discard_count",
    "pending_copy_count",
    "copy_state"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "card_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "total_files": {
      "type": "integer",
      "minimum": 0
    },
    "imported_count": {
      "type": "integer",
      "minimum": 0
    },
    "analyzed_count": {
      "type": "integer",
      "minimum": 0
    },
    "pending_review_count": {
      "type": "integer",
      "minimum": 0
    },
    "keep_count": {
      "type": "integer",
      "minimum": 0
    },
    "discard_count": {
      "type": "integer",
      "minimum": 0
    },
    "pending_copy_count": {
      "type": "integer",
      "minimum": 0
    },
    "copy_state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "unknown"
      ]
    },
    "active_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scene_count": {
      "type": "integer",
      "minimum": 0
    },
    "burst_group_count": {
      "type": "integer",
      "minimum": 0
    },
    "cover": {
      "oneOf": [
        {
          "$ref": "./photo.schema.json#/$defs/PreviewRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
