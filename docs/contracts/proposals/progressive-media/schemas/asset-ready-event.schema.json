{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birdbox.local/contracts/proposals/progressive-media/asset-ready-event.schema.json",
  "title": "AssetReadyEvent",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "asset_ready"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "project_id",
        "file_id",
        "kind",
        "status",
        "etag",
        "width",
        "height"
      ],
      "properties": {
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "file_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "thumbnail",
            "preview"
          ]
        },
        "status": {
          "const": "ready"
        },
        "etag": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "generation_mode": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
